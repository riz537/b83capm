  "scripts": {
    "start": "cds-serve",
    "watch-prdmgmtui": "cds watch --open com.demo.prdmgmtui/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-project1": "cds watch --open project1/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-ordermgmtui": "cds watch --open com.demo.ordermgmtui/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
